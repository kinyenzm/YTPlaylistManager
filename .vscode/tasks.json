{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: dotnet run",
      "type": "shell",
      "command": "dotnet run --launch-profile http",
      "options": { "cwd": "${workspaceFolder}/YTPlaylistManager.Server" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Now listening on:"
        }
      }
    },
    {
      "label": "frontend: ng serve",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/YTPlaylistManager.client" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "bundle generation complete"
        }
      }
    },
    {
      "label": "dev: full stack",
      "dependsOn": ["backend: dotnet run", "frontend: ng serve"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
